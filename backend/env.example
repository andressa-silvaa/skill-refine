# Rename/copy this file to `backend/.env` (or to repo root `.env`) for local development.

# ----------------------------
# Postgres (docker-compose)
# ----------------------------
POSTGRES_DB=skill_refine
POSTGRES_USER=skill_refine
POSTGRES_PASSWORD=skill_refine

# For local tools like Beekeeper Studio / Django
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# ----------------------------
# Django
# ----------------------------
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-me-in-dev

# 12-factor DB config for Django (django-environ will read this)
# Dev (no SSL):
DATABASE_URL=postgres://skill_refine:skill_refine@localhost:5433/skill_refine
#
# Production example (SSL required):
# DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require

# ----------------------------
# Auth (JWT + refresh cookie)
# ----------------------------
JWT_SECRET=change-me-too
JWT_ISSUER=skill-refine
JWT_ACCESS_TTL_MINUTES=15

PASSWORD_HASH_PEPPER=change-me-too
REFRESH_TOKEN_PEPPER=change-me-too
REFRESH_TTL_DAYS=30
REFRESH_COOKIE_NAME=sr_refresh
REFRESH_COOKIE_SECURE=0
REFRESH_COOKIE_SAMESITE=Lax
REFRESH_COOKIE_PATH=/

# ----------------------------
# Password reset
# ----------------------------
PASSWORD_RESET_CODE_TTL_MINUTES=10
PASSWORD_RESET_GRANT_TTL_MINUTES=15
PASSWORD_RESET_CODE_PEPPER=change-me-too

# ----------------------------
# Email confirmation
# ----------------------------
EMAIL_CONFIRMATION_TOKEN_TTL_HOURS=24
EMAIL_CONFIRMATION_TOKEN_PEPPER=change-me-too

# ----------------------------
# Frontend (CORS + email links + PDF generation)
# ----------------------------
# IMPORTANTE: Se o backend estiver em Docker e o frontend no host,
# o backend precisa acessar o frontend para gerar PDFs.
# 
# Opções:
# 1. localhost (funciona se ambos estiverem no host OU ambos no Docker)
# 2. host.docker.internal (funciona no Docker Desktop Windows/Mac)
# 3. IP da máquina host (ex: 192.168.1.100) - mais confiável
#
# Para descobrir seu IP no Windows: ipconfig | findstr IPv4
FRONTEND_URL=http://localhost:3000
# FRONTEND_URL=http://host.docker.internal:3000
# FRONTEND_URL=http://192.168.1.100:3000

# ----------------------------
# Cloudinary (avatars)
# ----------------------------
# Set this only in your local/prod `.env` (do not commit real secrets).
# Example:
# CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@dlkzgtckm
CLOUDINARY_URL=

# ----------------------------
# Google OAuth2
# ----------------------------
GOOGLE_OAUTH_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-google-client-secret

# ----------------------------
# Email (Resend recomendado — SMTP)
# Crie uma API key em https://resend.com/api-keys e verifique domínio ou use onboarding@resend.dev para testes.
#
# Opção A — só Resend (preenche smtp.resend.com, usuário resend e senha = API key):
#   RESEND_API_KEY=re_xxxxxxxx
#   DEFAULT_FROM_EMAIL=onboarding@resend.dev
#
# Opção B — SMTP Resend explícito (útil se também definir RESEND_API_KEY e quiser sobrescrever porta):
#   EMAIL_HOST=smtp.resend.com
#   EMAIL_PORT=587
#   EMAIL_USE_TLS=1
#   EMAIL_USE_SSL=0
#   EMAIL_HOST_USER=resend
#   EMAIL_HOST_PASSWORD=re_xxxxxxxx
#   (pode omitir EMAIL_HOST_PASSWORD se RESEND_API_KEY estiver definida)
#
# Outros provedores (deixe RESEND_API_KEY vazio):
# - Gmail: EMAIL_HOST=smtp.gmail.com EMAIL_PORT=587 EMAIL_USE_TLS=1
# - Brevo: EMAIL_HOST=smtp-relay.brevo.com EMAIL_PORT=587 EMAIL_USE_TLS=1
# ----------------------------
RESEND_API_KEY=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
EMAIL_USE_SSL=0
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=no-reply@skillrefine.local

# ----------------------------
# Analysis Inference (ml/models/ HF export)
# ----------------------------
# ANALYSIS_MODEL_ROOT=../ml/models
# Sklearn seniority (signals_ml) — caminho absoluto recomendado em produção:
# ANALYSIS_SIGNALS_ML_ENABLED=true
# ANALYSIS_SIGNALS_MODEL_DIR=C:/Skill-Refine-TCC/ml/models/seniority_signals_v1
# ANALYSIS_SIGNALS_THRESHOLDS_FROM_SETTINGS=true
# Thresholds (nomes curtos; sobrescrevem defaults se ANALYSIS_SIGNALS_* não forem setados)
# SENIOR_PROB_THRESHOLD=0.75
# SENIOR_MIN_MONTHS=60
# SENIOR_MIN_EXPERIENCES=2
# SENIOR_MIN_BULLETS=6
ANALYSIS_MODEL_VERSION=analysis_v1_pt
ANALYSIS_MODEL_MODE=hf
# ANALYSIS_ALLOW_HEURISTICS_FALLBACK=true
ANALYSIS_MAX_CHARS_RESUME=12000
ANALYSIS_MAX_CHARS_JOB=8000
ANALYSIS_PREWARM_ENABLED=true
ANALYSIS_PREWARM_LANGUAGES=pt-BR
ANALYSIS_PARALLEL_INFERENCE=true
# ANALYSIS_MULTILANG=false
ANALYSIS_MODEL_VERSION_BY_LANG=pt-BR=analysis_v1_pt;en-US=analysis_seniority_multi_v2_light;es-ES=analysis_seniority_multi_v2_light
ANALYSIS_MODEL_VERSION_BY_TASK=quality=analysis_quality_v9_pt;matching=analysis_matching_v3_reg_pt;seniority=text_seniority_v1
ANALYSIS_MODEL_VERSION_BY_TASK_LANG=quality:pt-BR=analysis_quality_v9_pt;quality:en-US=analysis_quality_multi_v1_light;quality:es-ES=analysis_quality_multi_v1_light;matching:pt-BR=analysis_matching_v3_reg_pt;matching:en-US=analysis_matching_multi_v1_light;matching:es-ES=analysis_matching_multi_v1_light
# Legacy TF-IDF (fallback when HF not available):
# ANALYSIS_TFIDF_MODEL_PATH=
# ANALYSIS_MODEL_DIR=

# ----------------------------
# AI Rewrite (cloud only, OpenAI-compatible)
# ----------------------------
AI_REWRITE_CACHE_TTL_SECONDS=600
# Ex.: Groq: AI_CLOUD_BASE_URL=https://api.groq.com/openai, AI_CLOUD_MODEL=llama-3.1-8b-instant
AI_CLOUD_BASE_URL=
AI_CLOUD_API_KEY=
AI_CLOUD_MODEL=
AI_CLOUD_TIMEOUT_SECONDS=15

# Redis (cache + Celery broker)
# Para Celery: subir Redis (ex: docker run -d -p 6379:6379 redis:alpine)
# REDIS_URL=redis://localhost:6379/0
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_TASKS_ENABLED=1


