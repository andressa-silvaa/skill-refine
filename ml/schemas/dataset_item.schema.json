{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DatasetItem",
  "description": "Unified record for raw/processed dataset: one resume (and optional job). Used for split-by-resume_id, validation, and reports. Task-specific rows (seniority/sections/quality/matching) are derived or stored separately per analysis_dataset.schema.json.",
  "type": "object",
  "required": ["id", "language", "resume_id", "resume_text", "labels", "heuristics", "source", "created_at"],
  "properties": {
    "id": {
      "type": "string",
      "description": "UUID or stable unique id for this record"
    },
    "language": {
      "type": "string",
      "enum": ["pt-BR", "en-US", "es-ES", "pt", "en", "es"],
      "description": "Language code; pipeline normalizes to pt|en|es internally"
    },
    "resume_id": {
      "type": "string",
      "description": "Stable id for the resume (split by this to avoid leakage)"
    },
    "job_id": {
      "type": "string",
      "description": "Optional; for matching task (job-resume pair)"
    },
    "resume_text": {
      "type": "string",
      "description": "Full resume text (normalized, PII masked)"
    },
    "job_text": {
      "type": "string",
      "description": "Optional; job description for matching task"
    },
    "sections": {
      "type": "object",
      "description": "Extracted sections: summary, experience, education, skills, projects, contact, other",
      "additionalProperties": { "type": "string" }
    },
    "labels": {
      "type": "object",
      "description": "Labels (seniority, quality_score, section_labels, etc.)",
      "properties": {
        "seniority": { "type": "string", "enum": ["intern", "junior", "mid", "senior"] },
        "quality_score": { "type": "number", "minimum": 0, "maximum": 100 },
        "quality_level": { "type": "string", "enum": ["poor", "ok", "good", "excellent"] },
        "section_lines": { "type": "array", "items": { "type": "object" } }
      }
    },
    "heuristics": {
      "type": "object",
      "description": "Feature flags from heuristic rules (for explainability)",
      "properties": {
        "has_metrics": { "type": "boolean" },
        "has_links": { "type": "boolean" },
        "has_action_verbs": { "type": "boolean" }
      }
    },
    "source": {
      "type": "string",
      "enum": ["public", "synthetic", "anonymized"],
      "description": "Data source"
    },
    "label_source": {
      "type": "string",
      "enum": ["heuristic", "manual", "revisado"],
      "description": "How labels were obtained"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp"
    },
    "token_length": {
      "type": "integer",
      "description": "Token count (e.g. BERTimbau) for truncation info"
    }
  }
}
